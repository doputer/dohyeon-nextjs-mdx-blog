{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",

  "ignorePatterns": [".claude/**", "**/node_modules/**", "**/.next/**", "public/**"],

  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["^@/.*", "^#/.*"],
    "customGroups": [
      {
        "groupName": "next",
        "elementNamePattern": ["next", "next*", "next*/**", "@next*", "@next*/**"]
      },
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react*", "react*/**"]
      }
    ],
    "groups": [
      ["next", "react"],
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "functions": ["clsx", "cn"],
    "stylesheet": "./src/static/styles/index.css"
  }
}
