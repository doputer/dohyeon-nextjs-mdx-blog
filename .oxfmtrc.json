{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "ignorePatterns": ["**/node_modules/**", "**/.next/**"],
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["@/", "#/"],
    "customGroups": [
      {
        "groupName": "next",
        "elementNamePattern": ["next", "next*", "next*/**"]
      },
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react*", "react*/**"]
      }
    ],
    "groups": [
      ["next", "react"],
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "functions": ["cn"],
    "stylesheet": "./src/static/styles/index.css"
  }
}
